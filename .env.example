# Не добавляйте реальные секреты в Git. Vite-переменные попадают в браузер.
VITE_YANDEX_METRIKA_ID=

# GitHub Pages: demo. VPS: api.
VITE_BACKEND_MODE=demo
VITE_PUBLIC_API_URL=
VITE_BASE_PATH=/TRAPPOLA/
PUBLIC_SITE_URL=https://tonblognet.github.io/TRAPPOLA

# Сервер. Скопируйте в .env только на VPS и замените значения.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://trappola:change-me@127.0.0.1:5432/trappola
DATABASE_SSL=false
APP_ORIGINS=http://localhost:5173,http://localhost:3000
SECURE_COOKIES=false
UPLOAD_DIR=uploads
FRONTEND_DIST=dist
SESSION_HOURS=12
MAX_UPLOAD_MB=8

# Используются только однократной командой pnpm admin:bootstrap.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Елена
